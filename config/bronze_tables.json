{
  "_about": "Bronze data contract. ONE place that says which columns each Bronze table has. Used by the Glue job (to pick and check columns) and by Terraform (to create the Athena tables). Keys = Bronze column name (snake_case, safe for Parquet/Athena); values = column name in the source file. 'required' columns must be in the file, otherwise the file is quarantined. Every value is stored as text in Bronze.",
  "_lineage": [
    "source_system",
    "source_file",
    "source_key",
    "source_sha256",
    "received_at_utc",
    "source_row",
    "ingest_run_id",
    "ingested_at_utc"
  ],
  "_lineage_about": "Added to every Bronze table: where each row came from (file, S3 key, checksum, arrival time, row in the file) and which run loaded it. The partition column business_date is added on top.",
  "bronze_cpty_mtm": {
    "description": "Counterparty MTM statements (Excel and PDF), one row per trade",
    "file_level": [
      "cpty_id",
      "agreement_type"
    ],
    "columns": {
      "trade_ref": "Trade Ref",
      "product": "Product",
      "notional": "Notional",
      "currency": "Currency",
      "mtm_cpty_view": "MTM (Cpty view)",
      "agreement": "Agreement"
    },
    "required": [
      "trade_ref",
      "notional",
      "currency",
      "mtm_cpty_view"
    ]
  },
